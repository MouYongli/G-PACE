{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grace/llm/extract-claims.json",
  "title": "Output of the writer call (plan 5.1, 5.6): a claim patch anchored to the messages of one extraction unit",
  "description": "Array bounds (user decision of 2026-11-26) end repetition loops under constrained decoding. First sized for units of at most 8 messages (claims 32, stances 16, same_as 8); widened in E007 (ablation G) so that one schema serves every granularity up to a whole session: claims 96, stances 48, same_as 16. The largest LoCoMo development session has 39 messages, so 96 claims allow about 2.5 per message there, far above the largest valid outputs seen (Qwen3-8B segment-8 run T022-20261126T184442Z-2a64: at most 30 claims in 8 messages, 99th percentile 27); a repetition loop at smaller units now ends at the writer's max_tokens instead and is split as invalid output.",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 16},
          "message": {"type": "integer", "minimum": 1},
          "subject": {"type": "string", "minLength": 1, "maxLength": 200},
          "predicate": {"type": "string", "minLength": 1, "maxLength": 80},
          "object": {"type": "string", "minLength": 1, "maxLength": 300},
          "object_type": {"enum": ["entity", "string", "integer", "boolean", "date", "dateTime", "time"]},
          "exclusive": {"type": "boolean"},
          "function": {"enum": ["request", "offer", "accept", "reject", "confirm", "inform", "commit", "question"]},
          "report_mode": {"enum": ["own", "quote", "hypothetical"]},
          "polarity": {"enum": ["positive", "negative"]},
          "certainty": {"enum": ["certain", "probable", "possible", "underspecified"]},
          "derived": {"type": "boolean"},
          "correction": {"type": "boolean"},
          "scope": {"type": ["string", "null"], "maxLength": 80},
          "valid_from": {"type": ["string", "null"], "maxLength": 32},
          "valid_until": {"type": ["string", "null"], "maxLength": 32},
          "time_expression": {"type": ["string", "null"], "maxLength": 120},
          "quote": {"type": ["string", "null"], "maxLength": 600}
        },
        "required": ["message", "subject", "predicate", "object"],
        "additionalProperties": false
      }
    },
    "stances": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "object",
        "properties": {
          "message": {"type": "integer", "minimum": 1},
          "claim": {"type": "string", "minLength": 1, "maxLength": 16},
          "function": {"enum": ["request", "offer", "accept", "reject", "confirm", "inform", "commit", "question"]},
          "report_mode": {"enum": ["own", "quote", "hypothetical"]},
          "polarity": {"enum": ["positive", "negative"]},
          "certainty": {"enum": ["certain", "probable", "possible", "underspecified"]},
          "derived": {"type": "boolean"},
          "ends": {"enum": ["change", "correction", null]},
          "valid_until": {"type": ["string", "null"], "maxLength": 32},
          "quote": {"type": ["string", "null"], "maxLength": 600}
        },
        "required": ["message", "claim", "function"],
        "additionalProperties": false
      }
    },
    "same_as": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "message": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "same_as": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "required": ["message", "name", "same_as"],
        "additionalProperties": false
      }
    }
  },
  "required": ["claims", "stances"],
  "additionalProperties": false
}
