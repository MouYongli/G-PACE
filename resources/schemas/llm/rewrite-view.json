{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grace/llm/rewrite-view.json",
  "title": "Output of view rewriting from raw text (ablation C): sentences, each labelled with the messages it is based on",
  "type": "object",
  "properties": {
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "text": {"type": "string", "minLength": 1}
        },
        "required": ["sources", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sentences"],
  "additionalProperties": false
}
