{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grace/llm/plan-query.json",
  "title": "Output of the query-planning call (plan 5.6): an IR query, the variables to fill and the fallback channels",
  "type": "object",
  "properties": {
    "ir": {"type": ["string", "null"], "minLength": 1},
    "time_window": {
      "type": ["object", "null"],
      "properties": {
        "phrase": {"type": "string", "minLength": 1},
        "label": {"type": "string", "pattern": "^\\?[A-Za-z][A-Za-z0-9_]*$"}
      },
      "required": ["phrase", "label"],
      "additionalProperties": false
    },
    "anchor": {
      "type": ["object", "null"],
      "properties": {
        "ir": {"type": "string", "minLength": 1},
        "bind": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["known", "valid"]}
        }
      },
      "required": ["ir", "bind"],
      "additionalProperties": false
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "var": {"type": "string", "pattern": "^\\?[A-Za-z][A-Za-z0-9_]*$"},
          "describes": {"type": "string", "minLength": 1}
        },
        "required": ["var", "describes"],
        "additionalProperties": false
      }
    },
    "fallback_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["bm25", "dense"]}
    },
    "reason": {"type": ["string", "null"]}
  },
  "required": ["ir", "variables", "fallback_channels"],
  "additionalProperties": false
}
