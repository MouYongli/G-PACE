# Shared benchmark store and run artifacts; they exist only in the main checkout (PROJECT_ROOT)
/data
/runs/

# Agent tools: worktrees created inside the repository, per-user settings
.claude/worktrees/
.claude/settings.local.json

# Local tool binaries (e.g. tectonic, installed by `make -C paper/latex tools`)
/.tools/

# Python environment, bytecode and build output
.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# Tool caches and reports
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Secrets and local environment files
.env
.env.*
!.env.example

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
