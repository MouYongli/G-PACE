    "turns": [
     {
      "id": "D1:1",
      "speaker": "Ana",
      "text": "Hi Ben! I started a pottery class yesterday, right after my shift at the bakery.",
      "image": null
     },
     {
      "id": "D1:2",
      "speaker": "Ben",
      "text": "Good for you! I play the cello in a community orchestra these days.",
      "image": null
     },
     {
      "id": "D1:3",
      "speaker": "Ana",
      "text": "I didn't know that. I used to play the flute, but I don't play it anymore.",
      "image": null
     },
     {
      "id": "D1:4",
      "speaker": "Ben",
      "text": "Something else is new: I moved to Lisbon two years ago and never told you.",
      "image": null
     },
     {
      "id": "D1:5",
      "speaker": "Ana",
      "text": "Lisbon, wow. Anyway, look what I made in class.",
      "image": {
       "caption": "a photo of a blue ceramic bowl with a fish painted inside",
       "query": "handmade ceramic bowl"
      }
     },
     {
      "id": "D1:6",
      "speaker": "Ben",
      "text": "That is lovely. I have two dogs now, Miso and Pepper.",
      "image": null
     }
    ]
   },
   {
    "id": "session_2",
    "index": 2,
    "date_time": "2024-04-10T18:30",
    "turns": [
     {
      "id": "D2:1",
      "speaker": "Ben",
      "text": "News from my side: I adopted a third dog last week. Her name is Olive.",
      "image": null
     },
     {
      "id": "D2:2",
      "speaker": "Ana",
      "text": "Three dogs! I changed jobs, by the way. I work at the city library now.",
      "image": null
     },
     {
      "id": "D2:3",
      "speaker": "Ben",
      "text": "Congratulations. Before Lisbon I lived in Porto, and the library there was my favourite place.",
      "image": null
     },
     {
      "id": "D2:4",
      "speaker": "Ana",
      "text": "I also ran my first 10k race on 6 April.",
      "image": null
     },
     {
      "id": "D2:5",
      "speaker": "Ben",
      "text": "Well done! I don't eat meat anymore, but I still eat fish.",
      "image": null
     },
     {
      "id": "D2:6",
      "speaker": "Ana",
      "text": "They gave everyone one of these at the finish.",
      "image": {
       "caption": "a photo of a finisher medal with the number 10 on it",
       "query": "race finisher medal"
      }
     }
    ]
   },
   {
    "id": "session_3",
    "index": 3,
    "date_time": "2024-06-01T09:00",
    "turns": [
     {
      "id": "D3:1",
      "speaker": "Ana",
      "text": "I ran a half marathon on 25 May!",
      "image": null
     },
     {
      "id": "D3:2",
      "speaker": "Ben",
      "text": "Amazing. This spring I went to concerts in Madrid, in Seville, and in Madrid again.",
      "image": null
     },
     {
      "id": "D3:3",
      "speaker": "Ana",
      "text": "I have felt much calmer since I started pottery.",
      "image": null
     },
     {
      "id": "D3:4",
      "speaker": "Ben",
      "text": "Olive has been ill, so I skipped two orchestra rehearsals to stay with her.",
      "image": null
     }
    ]
